# Copy this file to .env (in this folder) and change what you need. .env is never committed.

# The name or IPv4 address you will type to reach Pond. No https:// and no port.
# pond.local works when the computer is named "pond" and your network passes local names.
POND_ADDRESS=pond.local

# Required. Your time zone, such as America/Chicago or Europe/London. It sets bank dates and
# when scheduled backups run.
POND_TIMEZONE=

# Required. An existing folder for backups, ideally on another drive. Pond runs as user 1000,
# which must be able to write to it:  sudo chown 1000:1000 /path/to/folder
POND_BACKUP_FOLDER=

# The port for HTTPS. With another port, such as 8443, the address is https://pond.local:8443,
# and you must also delete ":compose.http-redirect.yml" from COMPOSE_FILE below.
POND_HTTPS_PORT=443

# With this line, port 80 sends browsers to HTTPS. To leave port 80 free, delete
# ":compose.http-redirect.yml".
COMPOSE_FILE=compose.yml:compose.http-redirect.yml
POND_HTTP_PORT=80

# Tells browsers to use only https for this name, on EVERY port, for up to a year. Turn it on
# (true) only if Pond is the only web app on this name, or all of them use https. Turning it off
# again doesn't make browsers forget right away. It has no effect with an IP address.
POND_HSTS=false
