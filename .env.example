# Server (all optional; defaults shown)
PORT=3210
HOST=0.0.0.0
POND_DATA_DIR=./data
LOG_LEVEL=info
# Bank sync (SimpleFIN)
# IANA time zone used to turn bank timestamps into calendar days (default: this machine's zone)
POND_TIMEZONE=America/New_York
# Hours between automatic syncs (4 to 24; default 12). SimpleFIN data refreshes about daily.
POND_SYNC_INTERVAL_HOURS=12
